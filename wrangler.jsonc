{
  "name": "botc-helper",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-28",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "ratelimits": [{ "name": "CHAT_LIMIT", "namespace_id": "1061", "simple": { "limit": 8, "period": 60 } }],
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "CHAT_STATE" }],
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "botc.leisurecat.cloud", "custom_domain": true }]
}
